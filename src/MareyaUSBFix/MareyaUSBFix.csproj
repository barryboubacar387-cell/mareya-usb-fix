<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 est déjà présent sur Windows 10 et 11 : aucun runtime à installer. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MareyaUSBFix</AssemblyName>
    <RootNamespace>MareyaUSBFix</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mareya USB Fix</Product>
    <Company>Mareya Group</Company>
    <Copyright>© Mareya Group</Copyright>
    <Description>Supprime le virus raccourci des clés USB et disques durs</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permet de compiler pour .NET Framework depuis n'importe quelle machine (y compris Linux). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="MareyaUSBFix.app.ico" />
  </ItemGroup>

</Project>
